    glVertex2f(100, 20);
    glVertex2f(100, 0);
    glEnd();

    glColor3f(0.459, 0.459, 0.459);
    glBegin(GL_QUADS);
    glVertex2f(0, 0);
    glVertex2f(0, 20);
    glVertex2f(100 - 80, 20);
    glVertex2f(100 - 80, 0);
    glEnd();

    glColor3f(0, 0, 0);
    for (int i = 0; i <= 4; i++) {
        glBegin(GL_LINES);
        glVertex2f(i * 20 + 10, 20);
        glVertex2f(i * 20 + 10, 50);
        glEnd();
    }

    // Balcony railing horizontal bar
    glBegin(GL_LINES);
    glVertex2f(0, 50);
    glVertex2f(100, 50);
    glEnd();
}

