    glVertex2f(70, 130);
    glVertex2f(70, 0);
    glEnd();
    glColor3f(0.459, 0.459, 0.459);
    glColor3f(0.89f, 0.694f, 0.024f);
    glBegin(GL_QUADS);
    glVertex2f(60, 60);
    glVertex2f(60, 70);
    glVertex2f(65, 70);
    glVertex2f(65, 60);
    glEnd();
}

void drawBalcony() {
