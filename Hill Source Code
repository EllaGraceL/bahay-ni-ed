// Hill
#include <GL/glut.h>
#include <cmath>

const int gridSize = 100;
const float scale = 0.1f;

void drawHill() {
    glColor3f(0.3f, 0.8f, 0.3f); // green

    for (int z = 0; z < gridSize - 1; ++z) {
        glBegin(GL_TRIANGLE_STRIP);
        for (int x = 0; x < gridSize; ++x) {
            float xpos = x * scale;
            float zpos = z * scale;
            float ypos = sin(xpos) * cos(zpos); 
            glVertex3f(xpos, ypos, zpos);

            float zposNext = (z + 1) * scale;
            float yposNext = sin(xpos) * cos(zposNext);
            glVertex3f(xpos, yposNext, zposNext);
        }
        glEnd();
    }
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    glLoadIdentity();

    gluLookAt(5, 5, 12,
        5, 0, 5,
        0, 1, 0);

    drawHill();

    glutSwapBuffers();
}

void init() {
    glEnable(GL_DEPTH_TEST);
    glMatrixMode(GL_PROJECTION);
    gluPerspective(45.0, 1.0, 1.0, 100.0);
    glMatrixMode(GL_MODELVIEW);

    glClearColor(0.529f, 0.808f, 0.922f, 1.0f); // sky blue
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH);
    glutInitWindowSize(800, 600);
    glutCreateWindow("Hill on a House");

    init();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}
